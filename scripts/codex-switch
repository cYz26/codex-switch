#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [[ -h "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
SWITCH_PY="${CODEX_SWITCH_SCRIPT:-$SCRIPT_DIR/codex_profile_switch.py}"
VERSION_FILE="$SCRIPT_DIR/../VERSION"
CODEX_SWITCH_VERSION="${CODEX_SWITCH_VERSION:-}"

PYTHON_BIN="${CODEX_SWITCH_PYTHON:-}"
if [[ -z "$PYTHON_BIN" ]]; then
  if command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
  elif [[ -x /usr/bin/python3 ]]; then
    PYTHON_BIN="/usr/bin/python3"
  else
    echo "python3 not found; set CODEX_SWITCH_PYTHON to a valid interpreter" >&2
    exit 1
  fi
fi

STORE_DIR="${CODEX_SWITCH_HOME:-$HOME/.codex-switch}"
GLOBAL_ARGS=()

usage() {
  cat <<'USAGE'
Usage:
  codex-switch [global options] <command> [command options]

One-key commands:
  internal                 Auto-update internal CLI if needed, then switch.
  official                 Switch to the official profile after a dry-run plan.
  check-update [profile]   Read-only Codex CLI update check.
  update-internal          Install or update the internal Codex CLI.
  env <command>            Run Codex workstation environment helper commands.
  install                  Symlink this wrapper to ~/.local/bin/codex-switch.
  version                  Print codex-switch version.

Pass-through commands:
  init | capture | switch | status | list | doctor | shim-env
  login-internal | login-official
  login | set-bin | set-app-bin
  raw <codex_profile_switch.py args...>

Global options:
  --store-dir <path>           Profile store. Default: ~/.codex-switch.
  --live-codex-home <path>     Live CODEX_HOME to switch. Default: CODEX_HOME or ~/.codex.
  --launch-agent-path <path>   LaunchAgent plist path.
  --launch-agent-label <name>  LaunchAgent label.

Switch options for internal/official:
  --dry-run                    Only print the switch plan.
  --snapshot                   Use whole-file config snapshot mode.
  --shared-config-base <name>  Rebuild shared config from a stored profile.
  --skip-launchctl             Write LaunchAgent but do not call launchctl.
  --skip-app-cli               Do not update Codex Desktop CODEX_CLI_PATH.
  --skip-shim                  Do not update the codex shim.
  --skip-login                 Do not auto-login official when file auth is missing.
  --skip-update-check          Do not check for updates or auto-update internal.
  --no-status                  Do not print status after a real switch.
  --skip-doctor                Do not run doctor after a real switch.

Examples:
  codex-switch internal
  codex-switch official --dry-run
  codex-switch check-update
  codex-switch update-internal --dry-run
  codex-switch env check-internal
  eval "$(codex-switch shim-env)"
USAGE
}

expand_shell_path() {
  local raw="$1"
  case "$raw" in
    "~") printf '%s\n' "$HOME" ;;
    "~/"*) printf '%s/%s\n' "$HOME" "${raw#~/}" ;;
    *) printf '%s\n' "$raw" ;;
  esac
}

run_switcher() {
  if ((${#GLOBAL_ARGS[@]})); then
    "$PYTHON_BIN" "$SWITCH_PY" "${GLOBAL_ARGS[@]}" "$@"
  else
    "$PYTHON_BIN" "$SWITCH_PY" "$@"
  fi
}

normalize_profile() {
  case "$1" in
    internal|i) printf '%s\n' "internal" ;;
    official|openai|openai-official|o) printf '%s\n' "openai-official" ;;
    *)
      echo "Unknown profile alias: $1" >&2
      exit 2
      ;;
  esac
}

profile_command_alias() {
  case "$1" in
    internal) printf '%s\n' "internal" ;;
    openai-official) printf '%s\n' "official" ;;
    *) printf '%s\n' "$1" ;;
  esac
}

print_section() {
  printf '\n== %s ==\n' "$1"
}

run_switch_step() {
  local profile="$1"
  local mode="$2"
  shift 2
  if [[ "$mode" == "dry-run" ]]; then
    run_switcher switch "$profile" --dry-run "$@"
  else
    run_switcher switch "$profile" "$@"
  fi
}

print_active_result_summary() {
  "$PYTHON_BIN" - "$STORE_DIR" <<'PY' || true
import json
import os
import sys
from pathlib import Path

store = Path(os.path.expandvars(sys.argv[1])).expanduser()
active_path = store / "active.json"
if not active_path.exists():
    print("Active profile: <none recorded>")
    raise SystemExit(0)
try:
    active = json.loads(active_path.read_text())
except Exception as exc:
    print(f"Active profile: <unavailable: {exc}>")
    raise SystemExit(0)

print(f"Active profile: {active.get('profile', '<unknown>')}")
fields = (
    ("Backup", "backup_dir"),
    ("Shim", "shim_path"),
    ("App CLI", "app_cli_path"),
    ("LaunchAgent", "launch_agent_path"),
)
for label, key in fields:
    value = active.get(key)
    if value:
        print(f"{label}: {value}")
PY
}

print_final_result() {
  local profile="$1"
  local outcome="$2"
  local switch_status="$3"
  local doctor_status="$4"
  local status_status="$5"
  local failed_step="${6:-}"
  local command_alias
  command_alias="$(profile_command_alias "$profile")"

  print_section "Final result"
  echo "Outcome: $outcome"
  echo "Profile: $profile"
  if [[ -n "$failed_step" ]]; then
    echo "Failed step: $failed_step"
  fi
  case "$switch_status" in
    succeeded) echo "Switch: succeeded" ;;
    skipped) echo "Switch: not run" ;;
    *) echo "Switch: failed${failed_step:+ at $failed_step} (exit $switch_status)" ;;
  esac
  case "$doctor_status" in
    passed) echo "Doctor: passed" ;;
    skipped) echo "Doctor: skipped" ;;
    not-run) echo "Doctor: not run" ;;
    *) echo "Doctor: failed (exit $doctor_status)" ;;
  esac
  case "$status_status" in
    printed) echo "Status: printed" ;;
    skipped) echo "Status: skipped" ;;
    not-run) echo "Status: not run" ;;
    *) echo "Status: failed (exit $status_status)" ;;
  esac

  if [[ "$switch_status" == "succeeded" ]]; then
    print_active_result_summary
  fi

  echo "Next steps:"
  case "$outcome" in
    SUCCESS)
      echo "- Restart Codex Desktop if it was already running."
      echo "- Verify active state: codex-switch status"
      ;;
    "ACTION REQUIRED")
      echo "- Review the Doctor section above and fix each listed issue."
      echo "- If it mentions running Codex Desktop or app-server, quit Codex Desktop completely and reopen it."
      echo "- Re-run doctor: codex-switch doctor"
      echo "- Check active state: codex-switch status"
      ;;
    "DRY RUN OK")
      echo "- Apply the switch: codex-switch $command_alias"
      ;;
    *)
      echo "- Fix the error printed above."
      echo "- Preview again: codex-switch $command_alias --dry-run"
      ;;
  esac
}

switch_profile() {
  local profile="$1"
  shift
  local dry_run=0
  local show_status=1
  local run_doctor=1
  local update_check=1
  local auto_login=1
  local switch_args=()

  while (($#)); do
    case "$1" in
      --dry-run)
        dry_run=1
        ;;
      --no-status)
        show_status=0
        ;;
      --skip-doctor|--no-doctor)
        run_doctor=0
        ;;
      --skip-update-check|--no-update-check)
        update_check=0
        ;;
      --skip-login|--no-login)
        auto_login=0
        ;;
      --snapshot)
        switch_args+=(--config-mode snapshot)
        ;;
      --shared-config-base|--config-mode)
        if [[ $# -lt 2 ]]; then
          echo "$1 requires a value" >&2
          exit 2
        fi
        switch_args+=("$1" "$2")
        shift
        ;;
      --)
        shift
        switch_args+=("$@")
        break
        ;;
      *)
        switch_args+=("$1")
        ;;
    esac
    shift
  done

  print_section "Dry-run plan"
  local plan_status=0
  # Bash 3.2 treats empty array expansion as unbound under `set -u`.
  if run_switch_step "$profile" dry-run ${switch_args[@]+"${switch_args[@]}"}; then
    plan_status=0
  else
    plan_status=$?
    print_final_result "$profile" "FAILED" "skipped" "not-run" "not-run" "dry-run plan"
    return "$plan_status"
  fi
  if [[ "$dry_run" == 1 ]]; then
    print_final_result "$profile" "DRY RUN OK" "skipped" "not-run" "not-run"
    return
  fi

  if [[ "$update_check" == 1 ]]; then
    print_section "Update check"
    local update_status=0
    if run_update_check_for_switch "$profile"; then
      update_status=0
    else
      update_status=$?
      print_final_result "$profile" "FAILED" "skipped" "not-run" "not-run" "update check"
      return "$update_status"
    fi
  else
    print_section "Update check"
    echo "Update check: skipped by command option."
  fi

  if [[ "$auto_login" == 1 ]]; then
    print_section "Profile preparation"
    local login_status=0
    if maybe_login_for_switch "$profile"; then
      login_status=0
    else
      login_status=$?
      print_final_result "$profile" "FAILED" "skipped" "not-run" "not-run" "profile preparation"
      return "$login_status"
    fi
  elif [[ "$profile" == "openai-official" ]]; then
    print_section "Profile preparation"
    echo "Official login: skipped by command option."
  fi

  print_section "Switch"
  local switch_status=0
  if run_switch_step "$profile" apply ${switch_args[@]+"${switch_args[@]}"}; then
    switch_status=0
  else
    switch_status=$?
    print_final_result "$profile" "FAILED" "$switch_status" "not-run" "not-run" "switch"
    return "$switch_status"
  fi

  local doctor_status="skipped"
  if [[ "$run_doctor" == 1 ]]; then
    print_section "Doctor"
    if run_switcher doctor; then
      doctor_status="passed"
    else
      doctor_status=$?
    fi
  fi

  local status_status="skipped"
  if [[ "$show_status" == 1 ]]; then
    print_section "Status"
    if run_switcher status; then
      status_status="printed"
    else
      status_status=$?
    fi
  fi

  if [[ "$doctor_status" == "passed" || "$doctor_status" == "skipped" ]] \
    && [[ "$status_status" == "printed" || "$status_status" == "skipped" ]]; then
    print_final_result "$profile" "SUCCESS" "succeeded" "$doctor_status" "$status_status"
    return 0
  fi

  print_final_result "$profile" "ACTION REQUIRED" "succeeded" "$doctor_status" "$status_status"
  if [[ "$doctor_status" != "passed" && "$doctor_status" != "skipped" ]]; then
    return "$doctor_status"
  fi
  return "$status_status"
}

profile_codex_bin() {
  local profile="$1"
  "$PYTHON_BIN" - "$STORE_DIR" "$profile" <<'PY'
import json
import os
import sys
from pathlib import Path

store = Path(os.path.expandvars(sys.argv[1])).expanduser()
profile = sys.argv[2]
manifest_path = store / "profiles" / profile / "manifest.json"
try:
    manifest = json.loads(manifest_path.read_text())
except FileNotFoundError:
    print(f"missing manifest: {manifest_path}", file=sys.stderr)
    raise SystemExit(2)
print(manifest.get("codex_bin") or "")
PY
}

profile_config_path() {
  local profile="$1"
  "$PYTHON_BIN" - "$STORE_DIR" "$profile" <<'PY'
import os
import sys
from pathlib import Path

store = Path(os.path.expandvars(sys.argv[1])).expanduser()
profile = sys.argv[2]
print(store / "profiles" / profile / "config.toml")
PY
}

profile_auth_path() {
  local profile="$1"
  "$PYTHON_BIN" - "$STORE_DIR" "$profile" <<'PY'
import os
import sys
from pathlib import Path

store = Path(os.path.expandvars(sys.argv[1])).expanduser()
profile = sys.argv[2]
print(store / "profiles" / profile / "auth.json")
PY
}

profile_uses_file_auth() {
  local profile="$1"
  local config_path
  config_path="$(profile_config_path "$profile")"
  [[ -f "$config_path" ]] || return 1
  grep -Eq '^[[:space:]]*cli_auth_credentials_store[[:space:]]*=[[:space:]]*"file"[[:space:]]*$' "$config_path"
}

maybe_login_for_switch() {
  local profile="$1"
  if [[ "$profile" != "openai-official" ]]; then
    return
  fi
  if skip_login_from_env; then
    echo "Official login: skipped by CODEX_SWITCH_SKIP_LOGIN."
    return
  fi
  if ! profile_uses_file_auth "$profile"; then
    return
  fi

  local auth_path
  auth_path="$(profile_auth_path "$profile")"
  if [[ -f "$auth_path" ]]; then
    return
  fi

  echo "Official login: missing $auth_path; running login before switch."
  if run_switcher login "$profile"; then
    true
  else
    return $?
  fi
  if [[ ! -f "$auth_path" ]]; then
    echo "Official login did not create $auth_path; aborting switch." >&2
    return 2
  fi
}

extract_version() {
  sed -nE 's/.*([0-9]+[.][0-9]+[.][0-9]+([-+][A-Za-z0-9.]+)?).*/\1/p' | head -n 1
}

env_setup_command() {
  if [[ -n "${CODEX_SWITCH_ENV_SETUP:-}" ]]; then
    printf '%s\n' "$CODEX_SWITCH_ENV_SETUP"
    return
  fi
  local bundled="$SCRIPT_DIR/codex_env_setup"
  if [[ -x "$bundled" ]]; then
    printf '%s\n' "$bundled"
    return
  fi
  if command -v codex-env-setup >/dev/null 2>&1; then
    command -v codex-env-setup
    return
  fi
  echo "codex-switch environment helper not found; reinstall codex-switch." >&2
  return 1
}

run_env_setup() {
  local env_setup
  env_setup="$(env_setup_command)"
  "$env_setup" "$@"
}

print_version() {
  if [[ -n "$CODEX_SWITCH_VERSION" ]]; then
    printf '%s\n' "$CODEX_SWITCH_VERSION"
    return
  fi
  if [[ -f "$VERSION_FILE" ]]; then
    sed -n '1p' "$VERSION_FILE"
    return
  fi
  printf '%s\n' "0.1.0-dev"
}

INTERNAL_PROFILE_CODEX_BIN=""
INTERNAL_UPDATE_NEEDED=0
INTERNAL_UPDATE_UNCERTAIN=0

check_internal_update() {
  local codex_bin
  INTERNAL_PROFILE_CODEX_BIN=""
  INTERNAL_UPDATE_NEEDED=0
  INTERNAL_UPDATE_UNCERTAIN=0
  codex_bin="$(profile_codex_bin internal)"
  INTERNAL_PROFILE_CODEX_BIN="$codex_bin"
  if [[ -z "$codex_bin" || ! -x "$codex_bin" ]]; then
    echo "internal profile codex_bin is missing or not executable: ${codex_bin:-<empty>}" >&2
    exit 2
  fi

  local current current_version latest_url headers location latest_tag latest_version
  current="$("$codex_bin" --version 2>/dev/null || true)"
  current_version="$(printf '%s\n' "$current" | extract_version)"
  latest_url="${CODEX_SWITCH_INTERNAL_LATEST_URL:-https://github.com/SDGLBL/codex/releases/latest}"

  echo "Internal profile codex: $codex_bin"
  echo "Current: ${current:-<unavailable>}"
  if ! headers="$(curl -fsSLI --max-time 20 "$latest_url" 2>/dev/null)"; then
    echo "Latest release: <unavailable from $latest_url>"
    echo "Update: unable to compare versions"
    echo "Run a dry-run update check with:"
    echo "  codex-switch update-internal --dry-run"
    return 1
  fi

  location="$(printf '%s\n' "$headers" | awk 'tolower($1) == "location:" { print $2 }' | tail -n 1 | tr -d '\r')"
  latest_tag="${location##*/}"
  latest_version="$(printf '%s\n' "$latest_tag" | extract_version)"
  echo "Latest release tag: ${latest_tag:-<unknown>}"

  if [[ -z "$current_version" || -z "$latest_version" ]]; then
    INTERNAL_UPDATE_UNCERTAIN=1
    echo "Update: available or unable to compare versions"
    echo "Preview:"
    echo "  codex-switch update-internal --dry-run"
    echo "Install:"
    echo "  codex-switch update-internal"
  elif [[ "$current_version" != "$latest_version" ]]; then
    INTERNAL_UPDATE_NEEDED=1
    echo "Update: available"
    echo "Preview:"
    echo "  codex-switch update-internal --dry-run"
    echo "Install:"
    echo "  codex-switch update-internal"
  else
    echo "Update: not needed"
  fi
}

check_official_update() {
  local codex_bin
  codex_bin="$(profile_codex_bin openai-official)"
  if [[ -z "$codex_bin" || ! -x "$codex_bin" ]]; then
    echo "official profile codex_bin is missing or not executable: ${codex_bin:-<empty>}" >&2
    exit 2
  fi
  echo "Official profile codex: $codex_bin"
  echo "Current: $("$codex_bin" --version 2>/dev/null || echo "<unavailable>")"
  echo "Update: managed by Codex Desktop / Codex.app; codex-switch does not modify the app bundle."
}

check_update() {
  local profile="internal"
  if (($#)); then
    profile="$(normalize_profile "$1")"
  fi
  if [[ "$profile" == "internal" ]]; then
    check_internal_update
  else
    check_official_update
  fi
}

skip_update_check_from_env() {
  case "${CODEX_SWITCH_SKIP_UPDATE_CHECK:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

skip_login_from_env() {
  case "${CODEX_SWITCH_SKIP_LOGIN:-}" in
    1|true|TRUE|yes|YES|on|ON) return 0 ;;
    *) return 1 ;;
  esac
}

run_update_check_for_switch() {
  local profile="$1"
  if skip_update_check_from_env; then
    echo "Update check: skipped by CODEX_SWITCH_SKIP_UPDATE_CHECK."
    return
  fi

  echo "Checking Codex CLI update for $profile..."
  if [[ "$profile" == "internal" ]]; then
    if ! check_internal_update; then
      echo "Update check did not complete; continuing with switch." >&2
      return
    fi
    if [[ "$INTERNAL_UPDATE_NEEDED" == 1 ]]; then
      run_internal_auto_update "$INTERNAL_PROFILE_CODEX_BIN"
    elif [[ "$INTERNAL_UPDATE_UNCERTAIN" == 1 ]]; then
      echo "Auto-update: skipped because the current/latest versions could not be compared." >&2
    fi
    return
  fi

  if ! check_update "$profile"; then
    echo "Update check did not complete; continuing with switch." >&2
  fi
}

run_internal_auto_update() {
  local codex_bin="$1"
  local env_setup install_dir after
  env_setup="$(env_setup_command)"
  install_dir="$(dirname "$codex_bin")"

  echo "Auto-update: internal Codex update detected."
  echo "Auto-update: running codex-switch update-internal --install-dir $install_dir"
  "$env_setup" update-internal --install-dir "$install_dir"
  after="$("$codex_bin" --version 2>/dev/null || true)"
  echo "Auto-update: completed. Internal Codex is now ${after:-<unavailable>}."
}

install_wrapper() {
  local target="${CODEX_SWITCH_INSTALL_PATH:-$HOME/.local/bin/codex-switch}"
  mkdir -p "$(dirname "$target")"
  ln -sf "$SCRIPT_DIR/codex-switch" "$target"
  echo "Installed: $target -> $SCRIPT_DIR/codex-switch"
  echo "Run: codex-switch status"
}

while (($#)); do
  case "$1" in
    --store-dir)
      if [[ $# -lt 2 ]]; then
        echo "--store-dir requires a value" >&2
        exit 2
      fi
      STORE_DIR="$(expand_shell_path "$2")"
      GLOBAL_ARGS+=("$1" "$2")
      shift 2
      ;;
    --live-codex-home|--launch-agent-path|--launch-agent-label)
      if [[ $# -lt 2 ]]; then
        echo "$1 requires a value" >&2
        exit 2
      fi
      GLOBAL_ARGS+=("$1" "$2")
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

cmd="${1:-}"
if [[ -z "$cmd" ]]; then
  usage
  exit 2
fi
shift

case "$cmd" in
  internal|i)
    switch_profile internal "$@"
    ;;
  official|openai|openai-official|o)
    switch_profile openai-official "$@"
    ;;
  check-update|update-check)
    check_update "$@"
    ;;
  update-internal)
    run_env_setup update-internal "$@"
    ;;
  check-internal)
    run_env_setup check-internal "$@"
    ;;
  check-official)
    run_env_setup check-official "$@"
    ;;
  desktop-guidance)
    run_env_setup desktop-guidance "$@"
    ;;
  env)
    run_env_setup "$@"
    ;;
  install)
    install_wrapper
    ;;
  version|--version|-v)
    print_version
    ;;
  login-internal)
    run_switcher login internal "$@"
    ;;
  login-official)
    run_switcher login openai-official "$@"
    ;;
  init|capture|switch|status|list|doctor|shim-env|login|set-bin|set-app-bin)
    run_switcher "$cmd" "$@"
    ;;
  raw)
    run_switcher "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
